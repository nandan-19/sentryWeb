{
  "manifest_version": 3,
  "name": "WebSec Agent",
  "version": "1.0.0",
  "description": "Local SLM and remote sandbox analysis for browser threats.",
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/index.ts-loader.js"
      ]
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "webRequest",
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:11434/"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "**/*",
        "*"
      ],
      "use_dynamic_url": false
    }
  ]
}
