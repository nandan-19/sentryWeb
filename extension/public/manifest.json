{
  "manifest_version": 3,
  "name": "WebSec Agent",
  "version": "1.0.0",
  "description": "Local SLM and remote sandbox analysis for browser threats.",
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"]
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "webRequest",
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:11434/"
  ]
}
